# Core API
DAY1_API_PORT=4010
DAY1_DB_PATH=./data/day1.local.sqlite

# Security/auth
# Generate with: openssl rand -hex 32
DAY1_TOTP_ENCRYPTION_KEY=<REQUIRED_HEX_64>
# Session cookie policy for deployed environments.
# Default in production is SameSite=None and Secure=true.
# Set domain only when sharing cookie scope across subdomains.
# DAY1_SESSION_COOKIE_SAME_SITE=none
# DAY1_SESSION_COOKIE_SECURE=true
# DAY1_SESSION_COOKIE_DOMAIN=

# Dynamic.xyz auth (optional onboarding/session bridge)
DAY1_DYNAMIC_AUTH_ENABLED=false
# Issuer/audience/JWKS must match Dynamic dashboard JWT settings
DAY1_DYNAMIC_JWT_ISSUER=<DYNAMIC_JWT_ISSUER>
DAY1_DYNAMIC_JWT_AUDIENCE=<DYNAMIC_JWT_AUDIENCE>
DAY1_DYNAMIC_JWKS_URL=<DYNAMIC_JWKS_URL>
# Frontend gate keeps Dynamic SDK disabled unless explicitly enabled.
VITE_DAY1_DYNAMIC_ENABLED=false
# Frontend publishable environment id used by DynamicContextProvider
VITE_DYNAMIC_ENVIRONMENT_ID=<DYNAMIC_ENVIRONMENT_ID>

# Wallet + chain mode
DAY1_CHAIN_MODE=ergo
DAY1_CHAIN_NETWORK=mainnet
DAY1_ERGO_SIGNING_MODE=external

# Wallet credentials (required)
DAY1_SERVER_WALLET_ADDRESS=<REQUIRED_MAINNET_ERGO_ADDRESS>
DAY1_SERVER_WALLET_SECRET=<REQUIRED_SERVER_SIGNER_SECRET>
DAY1_SERVER_WALLET_BALANCE_NANOERG=1000000000

# Ergo endpoints
# Required for signed tx broadcast
DAY1_ERGO_NODE_URL=<REQUIRED_MAINNET_NODE_URL>
# Optional override; defaults to https://api.ergoplatform.com
DAY1_ERGO_EXPLORER_URL=https://api.ergoplatform.com

# Ratification cadence
DAY1_RATIFY_INTERVAL_MS=5000
DAY1_RATIFY_BATCH_MAX_RECORDS=50
DAY1_RATIFY_MIN_INTERVAL_MS=1000
DAY1_RATIFY_MAX_INTERVAL_MS=300000
DAY1_RATIFY_ALLOW_API_OVERRIDE=true
DAY1_RATIFY_FINALITY_DEPTH=6

# Distributed limiter mode
DAY1_RATE_LIMIT_ADAPTER=sqlite
# DAY1_REDIS_URL=redis://localhost:6379
