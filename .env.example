# Core API
DAY1_API_PORT=4010
# Railway: set DAY1_API_PORT=$PORT in service env vars.
DAY1_DB_PATH=./.day1-data/day1.sqlite
# Comma-separated browser origins allowed to call cookie-auth endpoints.
DAY1_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth/security baseline
DAY1_TOTP_ENCRYPTION_KEY=replace-with-strong-random-value

# Dynamic.xyz auth bridge (optional; keep disabled unless configured)
DAY1_DYNAMIC_AUTH_ENABLED=false
DAY1_DYNAMIC_JWT_ISSUER=
DAY1_DYNAMIC_JWT_AUDIENCE=
DAY1_DYNAMIC_JWKS_URL=

# Ergo submit/status defaults for hosted test deployments
DAY1_CHAIN_NETWORK=testnet
DAY1_ERGO_NODE_URL=https://api-testnet.ergoplatform.com
DAY1_ERGO_EXPLORER_URL=https://api-testnet.ergoplatform.com

# Frontend gate: keep false unless Dynamic dashboard is configured for local origins.
VITE_DAY1_DYNAMIC_ENABLED=false
# Dynamic publishable environment UUID from dashboard.
VITE_DYNAMIC_ENVIRONMENT_ID=
